{
  "uid": "panther-pipeline-runs",
  "title": "Panther pipeline runs",
  "description": "Step Functions run counts, durations, and failures for the Editorial, Model, and Playback state machines. Metrics are the built-in AWS/States series. The CloudWatch data source is the datasource variable.",
  "tags": [
    "panther",
    "pipelines",
    "step-functions"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "CloudWatch data source",
        "type": "datasource",
        "query": "cloudwatch",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "region",
        "label": "Region",
        "type": "custom",
        "query": "us-west-2",
        "refresh": 0,
        "hide": 0,
        "current": {
          "text": "us-west-2",
          "value": "us-west-2",
          "selected": true
        },
        "options": [
          {
            "text": "us-west-2",
            "value": "us-west-2",
            "selected": true
          }
        ]
      },
      {
        "name": "editorial",
        "label": "Editorial state machine",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "regex": "/.*EditorialProcessing.*/",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "query": {
          "refId": "CloudWatchVariableQuery",
          "queryType": "dimensionValues",
          "namespace": "AWS/States",
          "metricName": "ExecutionsStarted",
          "dimensionKey": "StateMachineArn",
          "region": "$region",
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      },
      {
        "name": "model",
        "label": "Model state machine",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "regex": "/.*ModelProcessing.*/",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "query": {
          "refId": "CloudWatchVariableQuery",
          "queryType": "dimensionValues",
          "namespace": "AWS/States",
          "metricName": "ExecutionsStarted",
          "dimensionKey": "StateMachineArn",
          "region": "$region",
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      },
      {
        "name": "playback",
        "label": "Playback state machine",
        "type": "query",
        "datasource": {
          "type": "cloudwatch",
          "uid": "${datasource}"
        },
        "refresh": 1,
        "regex": "/.*PlaybackProcessing.*/",
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {},
        "options": [],
        "query": {
          "refId": "CloudWatchVariableQuery",
          "queryType": "dimensionValues",
          "namespace": "AWS/States",
          "metricName": "ExecutionsStarted",
          "dimensionKey": "StateMachineArn",
          "region": "$region",
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Editorial runs by status",
