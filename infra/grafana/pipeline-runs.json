            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "region": "$region",
          "namespace": "AWS/States",
          "metricName": "ExecutionsStarted",
          "dimensions": {
            "StateMachineArn": [
              "$editorial"
            ]
          },
          "statistic": "Sum",
          "period": "3600",
          "queryMode": "Metrics",
          "metricQueryType": 0,
