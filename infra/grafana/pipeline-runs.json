{
  "uid": "panther-pipeline-runs",
  "title": "Panther pipeline runs",
  "description": "Workshop pipeline runs from the Panther/Pipelines namespace. One series per pipeline kind. The CloudWatch data source is the datasource variable.",
  "tags": [
    "panther",
    "pipelines"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "editable": true,
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "CloudWatch data source",
        "type": "datasource",
        "query": "cloudwatch",
        "refresh": 1,
        "hide": 0,
        "current": {},
        "options": []
      },
      {
        "name": "region",
        "label": "Region",
        "type": "custom",
        "query": "us-west-2",
        "refresh": 0,
        "hide": 0,
        "current": {
          "text": "us-west-2",
          "value": "us-west-2",
          "selected": true
        },
        "options": [
          {
            "text": "us-west-2",
            "value": "us-west-2",
            "selected": true
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Runs started, last 24 hours",
      "datasource": {
        "type": "cloudwatch",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "a",
          "datasource": {
            "type": "cloudwatch",
            "uid": "${datasource}"
          },
          "region": "$region",
          "queryMode": "Metrics",
          "metricQueryType": 0,
          "metricEditorMode": 1,
          "expression": "SEARCH('{Panther/Pipelines,Pipeline} MetricName=\"RunsStarted\"', 'Sum', 3600)",
          "id": "a",
          "period": "3600",
          "label": "${PROP('Dim.Pipeline')}",
          "statistic": "Pipeline} MetricName=\"RunsStarted"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "none"
      },
      "timeFrom": "24h"
    },
